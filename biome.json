{
    "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["**", "!**/node_modules", "!**/dist", "!**/build", "!**/.next", "!**/*.min.js"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100,
        "lineEnding": "lf"
    },
    "assist": { "actions": { "source": { "organizeImports": "off" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "correctness": {
                "noUnusedVariables": "warn",
                "noUnusedImports": "warn",
                "useExhaustiveDependencies": "warn",
                "noChildrenProp": "off"
            },
            "a11y": {
                "noLabelWithoutControl": "warn",
                "useKeyWithClickEvents": "warn",
                "useSemanticElements": "warn"
            },
            "security": {
                "noDangerouslySetInnerHtml": "warn"
            },
            "suspicious": {
                "noArrayIndexKey": "warn",
                "noExplicitAny": "warn"
            },
            "style": {
                "noNonNullAssertion": "warn",
                "useConst": "error"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "trailingCommas": "es5",
            "semicolons": "always"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    }
}
